#!/bin/bash
# gate: runs the test suite, crapper, dryer and mutator and prints one short
# summary, so callers keep their context small. Exits 1 on FAIL.
set -uo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "$HERE/.." && pwd)"
SINCE="HEAD"
USAGE='usage: tools/gate [--root DIR] [--since REF | --full]
  Runs tests, crapper, dryer and mutator. The mutator only mutates lines
  changed since REF (default HEAD); --full mutates everything.'

fail=0

test_summary() {
    local out rc
    out="$(cd "$ROOT" && bash tests/run.sh 2>&1)" && rc=0 || rc=$?
    local line total passed
    line="$(printf '%s\n' "$out" | grep -E '^[0-9]+ tests: ' | tail -1)"
    total="$(printf '%s\n' "$line" | sed -E 's/^([0-9]+) tests:.*/\1/')"
    passed="$(printf '%s\n' "$line" | sed -E 's/^[0-9]+ tests: ([0-9]+) passed.*/\1/')"
    echo "Tests: ${passed:-0}/${total:-0}"
    [ "$rc" -eq 0 ]
}

crapper_summary() {
    local rows
    rows="$("$HERE/crapper" --root "$ROOT" 2>&1 | awk '$1 + 0 >= 10 && $5 ~ /:/ {
        printf "  - %s %s CRAP %.1f (complexity %s, coverage %s)\n", $5, $4, $1, $2, $3 }')"
    echo "Crapper: $(count_lines "$rows") over threshold"
    [ -z "$rows" ] || echo "$rows"
    [ -z "$rows" ]
}

dryer_summary() {
    local rows
    rows="$("$HERE/dryer" --root "$ROOT" 2>&1 | grep -E '^[0-9]\.[0-9]+  ' | sed -E 's/^/  - /; s/  +/ /g')"
    echo "Dryer: $(count_lines "$rows") regions"
    [ -z "$rows" ] || echo "$rows"
    [ -z "$rows" ]
}

mutator_summary() {
    local out rows total killed
    out="$("$HERE/mutator" --root "$ROOT" ${SINCE:+--since "$SINCE"} 2>&1)"
    rows="$(printf '%s\n' "$out" | grep '^SURVIVED' | sed -E 's/^SURVIVED ([^ ]+)  (.*)  \|  .*/  - \1 \2/')"
    total="$(printf '%s\n' "$out" | sed -nE 's/^mutants: ([0-9]+) .*/\1/p')"
    killed="$(printf '%s\n' "$out" | sed -nE 's/^mutants: [0-9]+  killed: ([0-9]+) .*/\1/p')"
    echo "Mutator: ${killed:-0}/${total:-0} killed"
    [ -z "$rows" ] || echo "$rows"
    [ -z "$rows" ]
}

count_lines() {
    [ -z "$1" ] && echo 0 || printf '%s\n' "$1" | wc -l | tr -d ' '
}

parse_args() {
    while [ $# -gt 0 ]; do
        case "$1" in
            --root) ROOT="$(cd "$2" && pwd)"; shift 2 ;;
            --since) SINCE="$2"; shift 2 ;;
            --full) SINCE=""; shift ;;
            *) echo "$USAGE"; exit 2 ;;
        esac
    done
}

main() {
    parse_args "$@"
    local body
    body="$(
        if test_summary; then
            crapper_summary || echo "!"
            dryer_summary || echo "!"
            mutator_summary || echo "!"
        else
            echo "!"
        fi
    )"
    if printf '%s\n' "$body" | grep -q '^!$'; then fail=1; fi
    printf 'Gate: %s\n' "$([ "$fail" -eq 0 ] && echo PASS || echo FAIL)"
    printf '%s\n' "$body" | grep -v '^!$'
    exit "$fail"
}

main "$@"
